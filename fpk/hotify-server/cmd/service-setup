#!/bin/bash
# service-setup — fnOS 框架层钩子脚本（conversun/fnos-apps 155-app 模板同款，参照 wg-easy/n8n）。
#
# NOTE: wizard answers reach the container through compose substitution in
# docker-compose.yaml (${wizard_tz} / ${wizard_external_url} ...), NOT from here.
# Patching the compose in service_postinst cannot work: fnOS creates the
# container BEFORE install_callback runs, so the edit lands on disk only
# (wg-easy AGENTS.md pitfall #3 原注). apply_port below is kept for the
# post-install config wizard (wizard/config → service_postconfig), which is a different flow.

COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"
PORT_SAVE="${TRIM_PKGVAR}/.port"

apply_port() {
    local port="$1"
    [ -z "$port" ] && return
    sed -i 's/"[^"]*:8443"/"'"${port}"':8443"/' "$COMPOSE_FILE"
    echo "${port}" > "$PORT_SAVE"
    install_log "Patched docker-compose.yaml: port=${port}"
}

service_postinst() {
    mkdir -p "${TRIM_PKGVAR}/data" 2>/dev/null || true
}

service_postupgrade() {
    if [ -f "$PORT_SAVE" ]; then
        apply_port "$(cat "$PORT_SAVE")"
    fi
}

service_postconfig() {
    if [ -n "${wizard_port:-}" ]; then
        apply_port "${wizard_port}"
    fi
}
